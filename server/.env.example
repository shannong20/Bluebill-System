# ─────────────────────────────────────────────────────────────
#  AquaPure Refilling Station — server configuration
#  Copy to `.env` and adjust.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────
# Paste your MongoDB Atlas connection string here, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# A local mongod works too: mongodb://127.0.0.1:27017
#
# Leave MONGODB_URI blank to boot an in-memory MongoDB automatically
# (great for a first run — the data is discarded when the server stops).
MONGODB_URI=
MONGODB_DB_NAME=aquapure

# Set to true to force the in-memory database even if MONGODB_URI is set.
USE_MEMORY_DB=false
MEMORY_DB_PORT=27018

# Seed the demo data automatically when the database is empty on boot.
# Handy for a first run; set to false in production.
AUTO_SEED=true

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# ── HTTP ───────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
