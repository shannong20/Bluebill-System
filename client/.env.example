#  AquaPure Refilling Station — frontend configuration
# ─────────────────────────────────────────────────────────────

# Base URL of the Node/Express API.
# On Vercel the client and server share one domain and /api/* is rewritten
# to the server service, so a relative same-origin path works in dev and prod.
# To run the client against a standalone local server instead, override this,
# e.g. NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_URL=/api
